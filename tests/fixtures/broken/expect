# A cascade of load failures folds into the script that actually broke.
#
# Godot prints its own parse errors to stderr here, so SCRIPT ERROR is expected
# rather than a symptom. Every other fixture forbids it.
#
# Folded into broken_base, not reported each:
#   child_named       extends the class name
#   child_by_path     extends "res://src/child_named.gd", one hop further down
#   child_with_inner  has an inner class, which must not confuse the lookup
#   decoy             says "extends Node" in a comment above its real header
#
# ghost_child stays on its own: it writes `extends Ghost`, an inner class of
# another file, which Godot cannot resolve either. Folding it there would be a
# relationship the engine does not have.
#
# flags: --check-members --check script-load-failed
# target: res://src
# exit: 2
# allow-script-errors: yes
src/annotated_base.gd:1 script-load-failed ~ 1 dependent
src/broken_base.gd:1 script-load-failed ~ 4 dependent
src/ghost_child.gd:1 script-load-failed ~ compile (see the parse error above)
src/own_line.gd:1 script-load-failed ~ 1 dependent
